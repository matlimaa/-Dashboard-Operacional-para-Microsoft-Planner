            'Afeta 100-': ['Afeta 100-'],
            'Afeta 1000+': ['Afeta 1000+'],
            'Falha elétrica': ['Falha elétrica'],
        };

        const buckets = [];

        for (const [nome, aliases] of Object.entries(bucketsMap)) {
            for (const alias of aliases) {
                const aliasEscapado = alias.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                const regex = new RegExp(`(^|\\s|\\b)${aliasEscapado}(\\b|\\s|$)`, 'i');

                if (regex.test(resto)) {
                    if (!buckets.includes(nome)) buckets.push(nome);
                    resto = resto.replace(regex, ' ').replace(/\s{2,}/g, ' ').trim();
                }
            }
        }

        const redes = [
            'Polo MOR', 'Polo RGT', 'Polo CE', 'Polo BHS', 'Polo SJM',
            'Polo PSA', 'Polo MOC', 'Polo ITV', 'Polo TBS', 'Polo WBY',
            'Polo SPR', 'Polo VGA', 'Polo SJV', 'Polo SOC', 'Polo SAL',
            'Polo LRA', 'Polo RN/PB', 'Polo PGU', 'Polo AFN'
        ];

        let rede = '';
        for (const r of redes) {
            const regexRede = new RegExp(r.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'i');
            if (regexRede.test(resto)) {
                rede = r;
                resto = resto.replace(regexRede, '').replace(/\s{2,}/g, ' ').trim();
                break;
            }
        }

        const descricao = resto.trim();

        return { status, dataHora, ruiet, descricao, buckets, rede };
    }

    function linhaEstaConcluida(linha) {
        const texto = String(linha || '').trim();
        if (!texto) return false;

        // Sinalizações concluídas não devem permanecer em nenhum painel.
        // Considera os ícones de conclusão e descrições textuais usuais.
        return /^(?:✅|✔️?|☑️|✖️?)\s*/u.test(texto)
            || /\b(?:CONCLU[IÍ]D[AO]|FINALIZAD[AO]|ENCERRAD[AO]|RESOLVID[AO])\b/i.test(texto);
