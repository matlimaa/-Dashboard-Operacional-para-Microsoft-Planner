    function escaparHtml(texto) {
        return String(texto || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    function formatarDuracao(minutos) {
        const total = Math.max(0, Math.floor(Number(minutos) || 0));
        const h = Math.floor(total / 60);
        const m = total % 60;
        return h > 0 ? `${h}h ${m}m` : `${m}m`;
    }

    function obterDataChamado(dataHoraStr) {
        if (!dataHoraStr) return null;

        const agora = new Date();
        const ano = agora.getFullYear();

        let match = String(dataHoraStr).match(/(\d{1,2})\/(\d{1,2})\s+(\d{1,2}):(\d{2})/);
        if (match) {
            const [, dia, mes, hora, minuto] = match;
            const data = new Date(
                ano,
                Number(mes) - 1,
                Number(dia),
                Number(hora),
                Number(minuto)
            );
            return isNaN(data.getTime()) ? null : data;
        }

        match = String(dataHoraStr).match(/(\d{1,2}):(\d{2})/);
        if (match) {
            const [, hora, minuto] = match;
            const data = new Date(
                ano,
                agora.getMonth(),
                agora.getDate(),
                Number(hora),
                Number(minuto)
            );

            if (data > agora) {
                data.setDate(data.getDate() - 1);
            }

            return isNaN(data.getTime()) ? null : data;
        }

        return null;
    }

    function obterDataPossivelFutura(dataHoraStr) {
        if (!dataHoraStr) return null;

        const agora = new Date();
        const ano = agora.getFullYear();

        let match = String(dataHoraStr).match(/(\d{1,2})\/(\d{1,2})\s+(\d{1,2}):(\d{2})/);
        if (match) {
            const [, dia, mes, hora, minuto] = match;
            const data = new Date(
                ano,
                Number(mes) - 1,
                Number(dia),
                Number(hora),
                Number(minuto)
            );
            return isNaN(data.getTime()) ? null : data;
        }

        match = String(dataHoraStr).match(/(\d{1,2}):(\d{2})/);
        if (match) {
            const [, hora, minuto] = match;
            const data = new Date(
                ano,
                agora.getMonth(),
                agora.getDate(),
                Number(hora),
                Number(minuto)
            );
            return isNaN(data.getTime()) ? null : data;
        }

        return null;
    }

    function estaAgendado(dataHoraStr) {
        const data = obterDataPossivelFutura(dataHoraStr);
        if (!data) return false;
        return data > new Date();
    }

    function parseDuracaoPrazo(texto) {
        const valor = String(texto || '').trim();
        const match = valor.match(/^(\d{1,2}):(\d{2})$/);
        if (!match) return null;

        const [, horas, minutos] = match;
        return {
            horas: Number(horas),
            minutos: Number(minutos)
        };
    }

    function calcularPrazoFinal(dataHoraStr, duracaoTexto) {
        const inicio = obterDataChamado(dataHoraStr);
        const duracao = parseDuracaoPrazo(duracaoTexto);

        if (!inicio || !duracao) return null;

        const prazo = new Date(inicio);
        prazo.setHours(prazo.getHours() + duracao.horas);
        prazo.setMinutes(prazo.getMinutes() + duracao.minutos);

        return prazo;
    }

    function formatarDataHoraPrazo(data) {
        if (!(data instanceof Date) || isNaN(data.getTime())) return '';

        const dia = String(data.getDate()).padStart(2, '0');
        const mes = String(data.getMonth() + 1).padStart(2, '0');
        const hora = String(data.getHours()).padStart(2, '0');
        const minuto = String(data.getMinutes()).padStart(2, '0');

        return `${dia}/${mes} ${hora}:${minuto}`;
    }

    function calcularStatusPrazo(dataHoraStr, duracaoTexto) {
      if (duracaoTexto === 'INDEFINIDO') {
    return {
        prazoFinal: null,
        prazoFinalTexto: 'INDEFINIDO',
        statusTexto: 'Prazo indefinido'
    };
}
        const prazoFinal = calcularPrazoFinal(dataHoraStr, duracaoTexto);
        if (!prazoFinal) return null;

        const agora = new Date();
        const diffMin = Math.floor((prazoFinal - agora) / 60000);
        const absMin = Math.abs(diffMin);

        return {
            prazoFinal,
            prazoFinalTexto: formatarDataHoraPrazo(prazoFinal),
            statusTexto: diffMin >= 0
                ? `Prazo em ${formatarDuracao(absMin)}`
                : `Estourado há ${formatarDuracao(absMin)}`
        };
    }

    function calcularTempoInfo(dataHoraStr) {
        if (!dataHoraStr) {
            return { texto: '', minutosTotais: -1, cor: '#fff' };
        }

        if (estaAgendado(dataHoraStr)) {
            return {
                texto: 'Agendado',
                minutosTotais: -1,
                cor: '#42a5f5'
            };
        }

        const data = obterDataChamado(dataHoraStr);
        if (!data) {
            return { texto: '', minutosTotais: -1, cor: '#fff' };
        }

        const agora = new Date();
        let diff = Math.floor((agora - data) / 60000);
        if (diff < 0) diff = 0;

        const texto = formatarDuracao(diff);

        let cor = '#00c853';
        if (diff >= 60) cor = '#ff5252';
        else if (diff >= 40) cor = '#ffd600';

        return {
            texto,
            minutosTotais: diff,
            cor
        };
    }

    function limparPrazoExpiradoSeNecessario(ruiet, dataHoraStr) {
        if (!ruiet) return false;

        const ignorado = prazoIgnorado(ruiet);
        const prazoEquipe = obterPrazoEquipe(ruiet);
      if (prazoEquipe === 'INDEFINIDO') {
    return false;
}

        if (!ignorado || !prazoEquipe) return false;

        const statusPrazo = calcularStatusPrazo(dataHoraStr, prazoEquipe);
        if (!statusPrazo || !statusPrazo.prazoFinal) return false;

        if (statusPrazo.prazoFinal <= new Date()) {
            removerIgnorado(ruiet);
            removerPrazoEquipe(ruiet);
            return true;
        }

        return false;
    }

    function processarPrazosExpirados(dados) {
        const linhas = String(dados || '').split('\n');

        linhas.forEach(l => {
            if (!l.trim()) return;
if (!/(RUIET-|Ticket#)/i.test(l)) return;

            const c = extrairCamposLinha(l);
            if (!c.ruiet || !c.dataHora) return;

            limparPrazoExpiradoSeNecessario(c.ruiet, c.dataHora);
        });
    }

