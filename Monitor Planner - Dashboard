function normalizarIdentificadorTicket(valor) {
    return String(valor || '')
        .replace(/^\-\s*/, '')
        .trim()
        .toUpperCase();
}

function extrairDetalhesNota(texto) {
    const conteudo = String(texto || '');

    // Somente a linha "Concessionaria: HH:MM" alimenta os cards laterais.
    // Linhas genéricas como "Prazo:" ou "SLA:" não entram nessa seção.
    const horarioConcessionaria =
        conteudo.match(/concession[aá]ria\s*:\s*(\d{1,2}:\d{2})(?=\s*(?:;|$|\n|\r))/im)?.[1]?.trim() || '';

    return {
        texto: conteudo,
        horarioConcessionaria
    };
}

function localizarIdentificadorNoElemento(elemento) {
    if (!elemento) return '';

    const candidatos = [
        elemento.closest('[role="row"]'),
        elemento.closest('[data-automationid]'),
        elemento.closest('li'),
        elemento.closest('tr'),
        elemento.parentElement
    ].filter(Boolean);

    for (const candidato of candidatos) {
        const texto = candidato.innerText || candidato.textContent || '';
        const match = texto.match(/RUIET-\d+|Ticket#\d+/i);
        if (match) return normalizarIdentificadorTicket(match[0]);
    }

    return '';
}

async function atualizarDetalhesNotasPlanner(forcar = false) {
    const agora = Date.now();

    if (varreduraNotasEmAndamento) return;
    if (!forcar && agora - ultimaVarreduraNotas < INTERVALO_VARREDURA_NOTAS_MS) return;

    const icones = [...document.querySelectorAll('i[data-icon-name="QuickNote"]')];
    if (!icones.length) {
        if (painelAberto) {
            definirStatusAtualizacao(
                'Erro: Quick Notes indisponíveis. Atualize a página (F5).',
                false,
                'erro'
            );
        }

        console.error(
            '[Monitor Planner] Nenhuma Quick Note foi encontrada na página.'
        );

        return;
    }

    definirStatusAtualizacao('Lendo Quick Notes...', true, 'normal');

    varreduraNotasEmAndamento = true;
    ultimaVarreduraNotas = agora;

    try {
        let houveAlteracao = false;
        const identificadoresEncontrados = new Set();

        for (let indiceNota = 0; indiceNota < icones.length; indiceNota++) {
            const icone = icones[indiceNota];
            let identificador = localizarIdentificadorNoElemento(icone);

            const botao = icone.closest('button');
            if (!botao) continue;

            botao.click();
            await new Promise(resolve => setTimeout(resolve, 500));

            const editor = document.querySelector('.notes-editor');
            const texto = editor?.innerText || editor?.textContent || '';

            if (!identificador) {
                const encontradoNaNota = texto.match(/RUIET-\d+|Ticket#\d+/i);
                identificador = encontradoNaNota
                    ? normalizarIdentificadorTicket(encontradoNaNota[0])
                    : `NOTA ${indiceNota + 1}`;
            }

            identificador = normalizarIdentificadorTicket(identificador);
            identificadoresEncontrados.add(identificador);

            const detalhes = extrairDetalhesNota(texto);

            // A nota completa fica independente do prazo da concessionária.
            const anterior = detalhesNotasPorTicket.get(identificador);
            if (!anterior || anterior.texto !== texto) {
                detalhesNotasPorTicket.set(identificador, { texto });
                houveAlteracao = true;
            }

            // Somente notas com "Concessionaria: HH:MM" entram nos cards laterais.
            const horarioAnterior = prazosConcessionariaPorTicket.get(identificador) || '';
            if (detalhes.horarioConcessionaria) {
                if (horarioAnterior !== detalhes.horarioConcessionaria) {
                    prazosConcessionariaPorTicket.set(
                        identificador,
                        detalhes.horarioConcessionaria
                    );
                    houveAlteracao = true;
                }
            } else if (prazosConcessionariaPorTicket.delete(identificador)) {
                houveAlteracao = true;
            }
        }

        // Remove registros antigos quando o nome/identificador do ticket foi alterado.
        // Isso evita manter simultaneamente o identificador anterior e o novo.
        for (const identificadorSalvo of [...detalhesNotasPorTicket.keys()]) {
            if (!identificadoresEncontrados.has(identificadorSalvo)) {
                detalhesNotasPorTicket.delete(identificadorSalvo);
                prazosConcessionariaPorTicket.delete(identificadorSalvo);
                houveAlteracao = true;
            }
        }

        for (const identificadorSalvo of [...prazosConcessionariaPorTicket.keys()]) {
            if (!identificadoresEncontrados.has(identificadorSalvo)) {
                prazosConcessionariaPorTicket.delete(identificadorSalvo);
                houveAlteracao = true;
            }
        }

        if (houveAlteracao && painelAberto) {
            assinaturaPainelLateral = '';
            atualizarDashboard(true);
        }
    } catch (erro) {
        console.warn('Não foi possível ler todas as notas do Planner:', erro);
        definirStatusAtualizacao('Erro ao ler Quick Notes', false, 'erro');
    } finally {
        varreduraNotasEmAndamento = false;

        const statusTexto =
            document.getElementById('statusAtualizacaoTexto')?.textContent || '';

        if (!/Erro/i.test(statusTexto)) {
            finalizarStatusAtualizacao();
        }
    }
}


function obterPrimeiroStatusConfirmadoNota(texto) {
    const linhas = String(texto || '').split(/\r?\n/);

    for (const linha of linhas) {
        const linhaLimpa = linha.trim();

        // Usa exatamente o primeiro status ✅ na ordem em que aparece na nota.
        if (!linhaLimpa.startsWith('✅')) continue;

        const dataHora = linhaLimpa.match(
            /(\d{1,2}\/\d{1,2}\s+\d{1,2}:\d{2})/
        );

        if (dataHora) return dataHora[1];
    }

    return '';
}

function formatarTimerConcessionaria(segundosTotais) {
    const total = Math.max(0, Math.floor(Number(segundosTotais) || 0));
    const horas = Math.floor(total / 3600);
    const minutos = Math.floor((total % 3600) / 60);
    const segundos = total % 60;

    if (horas > 0) {
        return `${horas}h ${String(minutos).padStart(2, '0')}m ${String(segundos).padStart(2, '0')}s`;
    }

    return `${minutos}m ${String(segundos).padStart(2, '0')}s`;
}

function obterTimerConcessionaria(horarioTexto) {
    const match = String(horarioTexto || '').trim().match(/^(\d{1,2}):(\d{2})$/);
    if (!match) return null;

    const horas = Number(match[1]);
    const minutos = Number(match[2]);

    if (horas > 23 || minutos > 59) return null;

    const agora = new Date();
    const prazoFinal = new Date(
        agora.getFullYear(),
        agora.getMonth(),
        agora.getDate(),
        horas,
        minutos,
        0,
        0
    );

    const diferencaSegundos = Math.floor((prazoFinal.getTime() - agora.getTime()) / 1000);
    const vencido = diferencaSegundos < 0;

    return {
        prazoFinal,
        vencido,
        texto: vencido
            ? `ESTOURADO HÁ ${formatarTimerConcessionaria(Math.abs(diferencaSegundos))}`
            : `FALTAM ${formatarTimerConcessionaria(diferencaSegundos)}`
    };
}

function gerarCardsPrazoConcessionaria() {
    const itens = [];

    // Exibe somente tickets cuja Quick Note contenha a palavra
