    function gerarListaCardsPrincipais(dados) {
        const linhas = String(dados || '').split('\n');
        const itens = [];

        linhas.forEach(l => {
            if (!l.trim()) return;
            if (l.includes('===')) return;
            if (!/(RUIET-|Ticket#)/i.test(l)) return;
            if (linhaEstaConcluida(l)) return;

            let dh = '';
            const matchCompleto = l.match(/(\d{1,2}\/\d{1,2}\s+\d{1,2}:\d{2})/);
            const matchHora = l.match(/(\d{1,2}:\d{2})/);

            if (matchCompleto) dh = matchCompleto[0];
            else if (matchHora) dh = matchHora[0];
            else return;

            const c = extrairCamposLinha(l);
            if (!c.ruiet) return;
            if (estaAgendado(c.dataHora)) return;

            const ehAgEquipe = Array.isArray(c.buckets) && c.buckets.includes('AG. Equipe');
            if (ehAgEquipe) return;

            limparPrazoExpiradoSeNecessario(c.ruiet, c.dataHora);

            const t = calcularTempoInfo(dh);
            itens.push({
                linha: l,
                atraso: t.minutosTotais,
                prazoAtivo: prazoIgnorado(c.ruiet) && !!obterPrazoEquipe(c.ruiet)
            });
        });

        itens.sort((a, b) => {
            const prazoA = obterPrazoEquipe(extrairCamposLinha(a.linha).ruiet);
            const prazoB = obterPrazoEquipe(extrairCamposLinha(b.linha).ruiet);

            // INDEFINIDO sempre por último.
            if (prazoA === 'INDEFINIDO' && prazoB !== 'INDEFINIDO') return 1;
            if (prazoA !== 'INDEFINIDO' && prazoB === 'INDEFINIDO') return -1;

            const atrasoA = isNaN(a.atraso) ? 0 : a.atraso;
            const atrasoB = isNaN(b.atraso) ? 0 : b.atraso;

            if (a.prazoAtivo !== b.prazoAtivo) {
                return a.prazoAtivo ? 1 : -1;
            }

            return atrasoB - atrasoA;
        });

        return itens;
    }

