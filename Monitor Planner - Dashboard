        if (!lista) return;

        const cards = Array.from(lista.children);
        if (!cards.length) {
            viewport.style.height = '0px';
            return;
        }

        // Remove alturas anteriores para medir o conteúdo real.
        cards.forEach(card => {
            card.style.height = 'auto';
            card.style.minHeight = '0';
        });

        // Todos os cards da mesma seção recebem a altura do maior card.
        // Assim, o card que entra por baixo nunca fica parcialmente cortado.
        const maiorAlturaConteudo = Math.max(
            ...cards.map(card => Math.ceil(card.getBoundingClientRect().height))
        );

        cards.forEach(card => {
            card.style.height = `${maiorAlturaConteudo}px`;
            card.style.minHeight = `${maiorAlturaConteudo}px`;
            card.style.overflow = 'visible';
        });

        const primeiro = cards[0];
        const estilo = getComputedStyle(primeiro);
        const alturaExterna = maiorAlturaConteudo
            + parseFloat(estilo.marginTop || 0)
            + parseFloat(estilo.marginBottom || 0);

        const quantidadeVisivel = Math.min(limite, cards.length);
        viewport.style.height = `${Math.ceil(alturaExterna * quantidadeVisivel + 6)}px`;
    }

