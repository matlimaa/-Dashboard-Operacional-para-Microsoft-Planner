    function atualizarDashboard(forcar = false) {
        const conteudoEl = document.getElementById('conteudo');
        if (!conteudoEl) return;

        if (!validarConteudoPlannerDisponivel()) {
            return;
        }

        definirStatusAtualizacao('Coletando tickets...', true, 'normal');

        const dados = obterDadosSeguros();

        definirStatusAtualizacao('Processando prazos...', true, 'normal');
        processarPrazosExpirados(dados);

        // Remove imediatamente dos mapas laterais qualquer ticket que não esteja
        // mais ativo nos dados atuais ou que já esteja marcado como concluído.
        const identificadoresAtivos = new Set();
        String(dados || '').split('\n').forEach(linha => {
            if (!/(RUIET-|Ticket#)/i.test(linha)) return;
            if (linhaEstaConcluida(linha)) return;

            const campos = extrairCamposLinha(linha);
            if (campos.ruiet) {
                identificadoresAtivos.add(normalizarIdentificadorTicket(campos.ruiet));
            }
        });

        if (identificadoresAtivos.size || /RUIET-|Ticket#/i.test(String(dados || ''))) {
            for (const identificador of [...detalhesNotasPorTicket.keys()]) {
                if (!identificadoresAtivos.has(normalizarIdentificadorTicket(identificador))) {
                    detalhesNotasPorTicket.delete(identificador);
                    prazosConcessionariaPorTicket.delete(identificador);
                    removerIgnorado(identificador);
                    removerPrazoEquipe(identificador);
                }
            }

            for (const identificador of [...prazosConcessionariaPorTicket.keys()]) {
                if (!identificadoresAtivos.has(normalizarIdentificadorTicket(identificador))) {
                    prazosConcessionariaPorTicket.delete(identificador);
                }
            }
        }

        // A leitura das notas ocorre em paralelo e atualiza os cards ao terminar.
        atualizarDetalhesNotasPlanner(false);

        const novaListaPrincipal = dados
            ? gerarListaCardsPrincipais(dados)
            : [];

        const novaAssinaturaPrincipal = novaListaPrincipal
            .map(item => {
                const ruiet = extrairCamposLinha(item.linha).ruiet;
                return `${item.linha}|${item.prazoAtivo}|${obterPrazoEquipe(ruiet)}`;
            })
            .join('\n');

        if (forcar || novaAssinaturaPrincipal !== assinaturaCardsPrincipais) {
            listaCardsPrincipaisAtual = novaListaPrincipal;
            assinaturaCardsPrincipais = novaAssinaturaPrincipal;

            // Só reconstrói os cards quando os dados realmente mudarem.
            // A rotação do carrossel apenas movimenta os elementos existentes,
            // preservando cores, ícones, prazos e a posição da sequência.
            renderizarPaginaPrincipal();
        }

        const novaLista = gerarPainelLateral(dados);
        const novaAssinatura = novaLista
            .map(item => `${item.tipo}|${item.html}`)
            .join('\n');

        if (forcar || novaAssinatura !== assinaturaPainelLateral) {
            definirStatusAtualizacao('Atualizando dashboard...', true, 'normal');

            listaPainelLateralAtual = novaLista;
            assinaturaPainelLateral = novaAssinatura;

            renderizarPaginaPainelLateral();
        }

        garantirRotacaoPainelLateral();
        garantirRotacaoCarrosselPrincipal();

        if (!varreduraNotasEmAndamento) {
            finalizarStatusAtualizacao();
        }
    }

