${escaparHtml(ticket.polo)}
</div>
</div>`
        });
    }

    // Primeiro os tickets sem prazo; depois, os horários mais próximos.
    itens.sort((a, b) => {
        if (a.possuiPrazo !== b.possuiPrazo) return a.possuiPrazo ? 1 : -1;
        if (!a.possuiPrazo && !b.possuiPrazo) {
            return a.identificador.localeCompare(b.identificador, 'pt-BR');
        }

        const timerA = obterTimerConcessionaria(a.prazo);
        const timerB = obterTimerConcessionaria(b.prazo);
        return (timerA?.prazoFinal?.getTime() || 0) - (timerB?.prazoFinal?.getTime() || 0);
    });

    return itens;
}

