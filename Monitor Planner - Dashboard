    const INTERVALO_COLETA_MS = 10000;
    const INTERVALO_ESTABILIDADE_MS = 300;
    const REPETICOES_ESTAVEIS = 3;

    let intervaloColetaPlanner = null;
    let coletaEmAndamento = false;
    let ultimaCapturaBruta = '';

    function limparTextoColetor(texto) {
        return String(texto || '')
            .replace(/[]/g, '')
            .replace(/\s+/g, ' ')
            .trim();
    }

    function capturarConteudoEstavel() {
        return new Promise(resolve => {
            let ultimaLeitura = '';
            let repeticoes = 0;
            let tentativas = 0;
            const maxTentativas = 40;

            const intervalo = setInterval(() => {
                tentativas++;

                const linhas = document.querySelectorAll('[role="row"]');
                const capturaAtual = [...linhas]
                    .map(linha => limparTextoColetor(linha.innerText))
                    .filter(Boolean)
                    .join('\n');

                if (capturaAtual && capturaAtual === ultimaLeitura) {
                    repeticoes++;
                } else {
                    repeticoes = 0;
                    ultimaLeitura = capturaAtual;
                }

                if (repeticoes >= REPETICOES_ESTAVEIS || tentativas >= maxTentativas) {
                    clearInterval(intervalo);
                    resolve(ultimaLeitura);
                }
            }, INTERVALO_ESTABILIDADE_MS);
        });
    }

    async function executarColetaPlanner(forcar = false) {
        if (coletaEmAndamento) return;
        coletaEmAndamento = true;

        try {
            const capturaAtual = await capturarConteudoEstavel();

            if (!capturaAtual.trim()) {
                console.log('[Monitor Planner] Sem dados válidos para coletar.');
                return;
            }

            const possuiTickets = /RUIET-|Ticket#/i.test(capturaAtual);
            if (!possuiTickets) {
                console.log('[Monitor Planner] A captura não contém tickets reconhecidos.');
                return;
            }

            const mudou = capturaAtual !== ultimaCapturaBruta;
            if (!forcar && !mudou) return;

            ultimaCapturaBruta = capturaAtual;
            const bloco = `=== ${new Date().toLocaleString('pt-BR')} ===\n${capturaAtual}`;

            localStorage.setItem(STORAGE_KEYS.DADOS, bloco);
            localStorage.setItem(STORAGE_KEYS.DADOS_VALIDOS, bloco);
            ultimoDadoValido = bloco;

            console.log(
                mudou
                    ? '[Monitor Planner] ✅ Snapshot atualizado.'
                    : '[Monitor Planner] ✅ Snapshot renovado.'
            );

            if (painelAberto) {
                ultimoConteudo = '';
                ultimoConteudoEquipe = '';
                ultimoConteudoAgendados = '';
                atualizarDashboard(true);
            }
        } catch (erro) {
            console.error('[Monitor Planner] Erro durante a coleta:', erro);
        } finally {
            coletaEmAndamento = false;
        }
    }

    function iniciarColetorPlanner() {
        if (intervaloColetaPlanner) return;

        executarColetaPlanner(true);
        intervaloColetaPlanner = setInterval(() => {
            executarColetaPlanner(false);
        }, INTERVALO_COLETA_MS);
    }

