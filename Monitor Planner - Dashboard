    String(dadosPlanner).split('\n').forEach(linha => {
        if (!linha.trim()) return;
        if (!/(RUIET-|Ticket#)/i.test(linha)) return;
        if (linhaEstaConcluida(linha)) return;

        const campos = extrairCamposLinha(linha);
        if (!campos.ruiet) return;

        const identificador = normalizarIdentificadorTicket(campos.ruiet);
        if (!identificador) return;

        ticketsAtuais.set(identificador, {
            identificador,
            polo: campos.rede || 'Polo não informado'
        });
    });

    for (const ticket of ticketsAtuais.values()) {
        const detalhesNota = detalhesNotasPorTicket.get(ticket.identificador);
        const textoNota = String(detalhesNota?.texto || '');

        // Sem a palavra Concessionaria na descrição/Quick Note, não entra na lateral.
        if (!/concession[aá]ria/i.test(textoNota)) continue;

        const horario = String(
            prazosConcessionariaPorTicket.get(ticket.identificador) || ''
        ).trim();

        const timer = horario ? obterTimerConcessionaria(horario) : null;
        const possuiPrazoValido = !!timer;

        const fundo = possuiPrazoValido
            ? (timer.vencido ? '#2a0f0f' : '#0f2a17')
            : '#242424';
        const borda = possuiPrazoValido
            ? (timer.vencido ? '#ff5252' : '#00c853')
            : '#757575';
        const corPrazo = possuiPrazoValido
            ? (timer.vencido ? '#ff5252' : '#69f0ae')
            : '#bdbdbd';
        const textoPrazo = possuiPrazoValido ? horario : 'NÃO INFORMADO';

        itens.push({
            identificador: ticket.identificador,
            prazo: horario,
            possuiPrazo: possuiPrazoValido,
            html: `
<div class="card-prazo-concessionaria" style="
