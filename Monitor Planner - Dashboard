    function girarCarrosselVertical(id) {
        const lista = document.getElementById(id);
        if (!lista || lista.dataset.animando === '1') return;

        const viewport = lista.closest('.viewport-carrossel-lateral');
        const limite = Number(viewport?.dataset.limite || 3);
        const cards = lista.children;

        // Só gira quando existem cards além da quantidade visível.
        if (cards.length <= limite) return;

        const primeiro = cards[0];
        const estilo = getComputedStyle(primeiro);
        const deslocamento = primeiro.getBoundingClientRect().height
            + parseFloat(estilo.marginTop || 0)
            + parseFloat(estilo.marginBottom || 0);

        if (!deslocamento) return;

        lista.dataset.animando = '1';
        lista.style.transition = 'none';
        lista.style.transform = 'translate3d(0, 0, 0)';

        let finalizado = false;

        const finalizar = () => {
            if (finalizado) return;
            finalizado = true;

            lista.removeEventListener('transitionend', aoFinalizarTransicao);

            // Reposiciona o card fora da animação para manter o loop contínuo.
            lista.appendChild(primeiro);
            lista.style.transition = 'none';
            lista.style.transform = 'translate3d(0, 0, 0)';
            lista.dataset.animando = '0';

            requestAnimationFrame(() => ajustarAlturaViewport(viewport));
        };

        const aoFinalizarTransicao = (evento) => {
            if (evento.target === lista && evento.propertyName === 'transform') {
                finalizar();
            }
        };

        lista.addEventListener('transitionend', aoFinalizarTransicao);

        // Dois frames garantem que o navegador prepare a camada antes de mover.
        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                lista.style.transition =
                    `transform ${DURACAO_ANIMACAO}ms cubic-bezier(0.22, 0.61, 0.36, 1)`;
                lista.style.transform = `translate3d(0, -${deslocamento}px, 0)`;
            });
        });

        // Segurança para navegadores que não disparem transitionend.
        setTimeout(finalizar, DURACAO_ANIMACAO + 250);
    }

