        atualizarDashboard(true);
        setTimeout(() => atualizarDetalhesNotasPlanner(true), 800);

        document.getElementById('fechar').onclick = fecharDashboard;
    }

    window.addEventListener('load', () => {
        criarBotao();
        iniciarReloadInteligente();
        iniciarColetorPlanner();

        if (localStorage.getItem(STORAGE_KEYS.DASH_ABERTO) === '1') {
            setTimeout(() => {
                abrirDashboard();
            }, 1500);
        }
    });
})();
